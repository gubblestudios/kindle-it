{
  "name": "Kindle It",
  "short_name": "Kindle It",
  "description": "Send articles and reading digests to your Kindle",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f1efe7",
  "theme_color": "#1612d3",
  "icons": [
    {
      "src": "/kindle-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml"
    },
    {
      "src": "/kindle-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
