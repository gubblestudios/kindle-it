# Core Kindle It configuration

# Gmail account used to send documents to Kindle
GMAIL_USER=

# 16-character Google App Password (not your normal Google password)
GMAIL_APP_PASSWORD=

# Your personal Send-to-Kindle email address
KINDLE_EMAIL=

# Long random secret used to protect the app endpoints
# Generate with: openssl rand -hex 32
APP_SECRET=

# Optional: shared Reading List storage
# These are only required if you use the bundled Upstash Redis implementation.
# If you wire Kindle It to Airtable, Supabase, Postgres, etc., use the
# environment variables required by that provider instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
