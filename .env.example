# Gmail account used to send documents to Kindle
GMAIL_USER=

# 16-character Google App Password (not your normal Google password)
GMAIL_APP_PASSWORD=

# Your personal Send-to-Kindle email address
KINDLE_EMAIL=

# Long random secret used to protect the app endpoints
# Generate with: openssl rand -hex 32
APP_SECRET=

# Upstash Redis REST credentials
KV_REST_API_URL=
KV_REST_API_TOKEN=
